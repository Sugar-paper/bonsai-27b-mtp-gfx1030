+void llama_memory_kvmem::register_capture(ggml_tensor * t, int il, char which) {
+    if (!t) {
+        return;
+    }
+    pending_capture_.push_back({t, il, which});
+    if (which == 'q') {
+        graph_has_q_ = true;
+    }
+    if (which == 'k') {
+        graph_has_k_ = true;
+    }
+}
