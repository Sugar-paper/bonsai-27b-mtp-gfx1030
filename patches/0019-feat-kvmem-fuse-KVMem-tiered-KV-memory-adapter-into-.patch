+static uint8_t * kvmem_mtp_cuda_ptr(ggml_tensor * t) {
+    if (!t || !t->data) {
+        return nullptr;
+    }
+    ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+    if (!buf || ggml_backend_buffer_is_host(buf)) {
+        return nullptr;
+    }
+    return static_cast<uint8_t *>(t->data);
+}
