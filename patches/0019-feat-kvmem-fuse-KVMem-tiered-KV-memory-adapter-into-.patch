+bool kvmem_stagein_h2d_bytes(void * gpu_dst, const void * host, size_t n) {
+    if (!gpu_dst || !host || n == 0) {
+        return n == 0;
+    }
+    return cuda_ok(kvmem_copy_async(gpu_dst, host, n, cudaMemcpyHostToDevice, stream()),
+                   "H2D bytes");
+}
