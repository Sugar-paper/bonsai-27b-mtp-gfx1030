+uint32_t RawKvStore::n_tokens(uint32_t block_id) const {
+    std::lock_guard<std::mutex> lk(mu_);
+    if (block_id >= blocks_.size()) {
+        return 0;
+    }
+    uint32_t n = 0;
+    for (const auto & lb : blocks_[block_id].layers) {
+        n = std::max(n, lb.n_tokens);
