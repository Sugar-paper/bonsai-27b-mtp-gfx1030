+    KvMemStoreConfig under = cfg;
+    under.select_budget = 32 * 16;
+    KvMemStore fit(under);
+    fit.register_append(32 * 4);
+    CHECK(!fit.prefill_needs_offload(96, 32, pool));  // 128 < 230, under budget
