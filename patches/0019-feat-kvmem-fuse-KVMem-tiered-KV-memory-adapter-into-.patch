+void llama_memory_kvmem::decode_mean_reset() {
+    decode_mean_flush();
+    decode_mean_discard();
+    decode_mean_n_ = 0;
+    decode_mean_block_ = ~0u;
+    decode_mean_pos0_ = 0;
+}
