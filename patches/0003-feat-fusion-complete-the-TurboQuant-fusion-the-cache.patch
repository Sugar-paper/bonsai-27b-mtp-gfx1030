diff --git a/tests/test-turbo-quant-cpu.cpp b/tests/test-turbo-quant-cpu.cpp
new file mode 100644
index 0000000..ac88452
--- /dev/null
+++ b/tests/test-turbo-quant-cpu.cpp
@@ -0,0 +1,143 @@
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+static double norm_squared(const float * data, int64_t n) {
+    double sum = 0.0;
+    for (int64_t i = 0; i < n; i++) {
+        sum += (double) data[i] * (double) data[i];
+    }
+    return sum;
+}
+
+int main() {
+    const int64_t ne = 128;
+    const int64_t nrows = 1;
+
+    if (ggml_blck_size(GGML_TYPE_TURBO3_0) != 32) {
+        std::fprintf(stderr, "turbo3 block size is %d, expected 32\n",
+                     (int) ggml_blck_size(GGML_TYPE_TURBO3_0));
+        return 1;
+    }
+
+    const size_t row_size = ggml_row_size(GGML_TYPE_TURBO3_0, ne);
+    if (row_size != 4 * 14) {
+        std::fprintf(stderr, "turbo3 row size for 128 values is %zu, expected 56\n", row_size);
+        return 1;
+    }
+
+    std::vector<float> source(ne);
+    for (int64_t i = 0; i < ne; i++) {
+        source[i] = 0.25f * std::sin(0.13f * i) + 0.75f * std::cos(0.041f * i);
+    }
+
+    struct ggml_init_params params = {
+        /*.mem_size   =*/ 16 * 1024 * 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ false,
+    };
+    struct ggml_context * ctx = ggml_init(params);
+    if (ctx == nullptr) {
+        std::fprintf(stderr, "ggml_init failed\n");
+        return 1;
+    }
+
+    struct ggml_tensor * a = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne);
+    for (int64_t i = 0; i < ne; i++) {
+        ((float *) a->data)[i] = source[i];
+    }
+    struct ggml_tensor * rotated = ggml_turbo_wht(ctx, a, 0, 0);
+    struct ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, rotated);
+    ggml_graph_compute_with_ctx(ctx, gf, 1);
+
+    std::vector<float> rotated_source(ne);
+    for (int64_t i = 0; i < ne; i++) {
+        rotated_source[i] = ((const float *) rotated->data)[i];
+    }
+
+    std::vector<float> input(ne);
+    for (int64_t i = 0; i < ne; i++) {
+        input[i] = source[i];
+    }
+
+    std::vector<uint8_t> quantized(row_size);
+    const size_t written = ggml_quantize_chunk(
+        GGML_TYPE_TURBO3_0, input.data(), quantized.data(), 0, nrows, ne, nullptr);
+    if (written != row_size) {
+        std::fprintf(stderr, "quantize_chunk wrote %zu bytes, expected %zu\n", written, row_size);
+        return 1;
+    }
+
+    std::vector<float> output(ne);
+    ggml_get_type_traits(GGML_TYPE_TURBO3_0)->to_float(quantized.data(), output.data(), ne);
+
+    const double in_norm  = std::sqrt(norm_squared(rotated_source.data(), ne));
+    const double out_norm = std::sqrt(norm_squared(output.data(), ne));
+    if (std::fabs(in_norm - out_norm) > 0.02 * in_norm) {
+        std::fprintf(stderr, "turbo3 norm mismatch: in=%.6f out=%.6f\n", in_norm, out_norm);
+        ggml_free(ctx);
+        return 1;
+    }
+
+    double dot = 0.0;
+    for (int64_t i = 0; i < ne; i++) {
+        dot += (double) rotated_source[i] * (double) output[i];
+    }
+    const double cosine = dot / (in_norm * out_norm);
+    if (cosine < 0.97) {
+        std::fprintf(stderr, "turbo3 cosine too low: %.6f\n", cosine);
+        ggml_free(ctx);
+        return 1;
+    }
+
+    ggml_free(ctx);
+
+    if (ggml_blck_size(GGML_TYPE_TURBO4_0) != 128) {
+        std::fprintf(stderr, "turbo4 block size is %d, expected 128\n",
+                     (int) ggml_blck_size(GGML_TYPE_TURBO4_0));
+        return 1;
+    }
+
+    const size_t row_size4 = ggml_row_size(GGML_TYPE_TURBO4_0, ne);
+    if (row_size4 != 68) {
+        std::fprintf(stderr, "turbo4 row size for 128 values is %zu, expected 68\n", row_size4);
+        return 1;
+    }
+
+    std::vector<uint8_t> quantized4(row_size4);
+    const size_t written4 = ggml_quantize_chunk(
+        GGML_TYPE_TURBO4_0, source.data(), quantized4.data(), 0, nrows, ne, nullptr);
+    if (written4 != row_size4) {
+        std::fprintf(stderr, "turbo4 quantize_chunk wrote %zu bytes, expected %zu\n", written4, row_size4);
+        return 1;
+    }
+
+    std::vector<float> output4(ne);
+    ggml_get_type_traits(GGML_TYPE_TURBO4_0)->to_float(quantized4.data(), output4.data(), ne);
+
+    const double in_norm4  = std::sqrt(norm_squared(rotated_source.data(), ne));
+    const double out_norm4 = std::sqrt(norm_squared(output4.data(), ne));
+    if (std::fabs(in_norm4 - out_norm4) > 0.02 * in_norm4) {
+        std::fprintf(stderr, "turbo4 norm mismatch: in=%.6f out=%.6f\n", in_norm4, out_norm4);
+        return 1;
+    }
+
+    double dot4 = 0.0;
+    for (int64_t i = 0; i < ne; i++) {
+        dot4 += (double) rotated_source[i] * (double) output4[i];
+    }
+    const double cosine4 = dot4 / (in_norm4 * out_norm4);
+    if (cosine4 < 0.99) {
+        std::fprintf(stderr, "turbo4 cosine too low: %.6f\n", cosine4);
+        return 1;
+    }
+
+    std::printf("test-turbo-quant-cpu: block=32 row_size=56 norm=%.6f cosine=%.6f\n",
+                out_norm, cosine);
+    return 0;
+}
diff --git a/tests/test-turbo-wht.cpp b/tests/test-turbo-wht.cpp
new file mode 100644
index 0000000..b20d083
--- /dev/null
+++ b/tests/test-turbo-wht.cpp
@@ -0,0 +1,85 @@
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+static bool close_enough(float a, float b, float rel_tol) {
+    const float scale = std::fmax(1.0f, std::fabs(a));
+    return std::fabs(a - b) <= rel_tol * scale;
+}
+
+int main() {
+    const int64_t ne0 = 128;
+    const int64_t ne1 = 3;
+    const int64_t n = ne0 * ne1;
+
+    struct ggml_init_params params = {
+        /*.mem_size   =*/ 16 * 1024 * 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ false,
+    };
+    struct ggml_context * ctx = ggml_init(params);
+    if (ctx == nullptr) {
+        std::fprintf(stderr, "ggml_init failed\n");
+        return 1;
+    }
+
+    struct ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne0, ne1);
+    std::vector<float> input(n);
+    for (int64_t i = 0; i < n; i++) {
+        input[i] = 0.25f * std::sin(0.13f * i) + 0.75f * std::cos(0.041f * i);
+        ((float *) a->data)[i] = input[i];
+    }
+
+    struct ggml_tensor * fwd = ggml_turbo_wht(ctx, a, 0, 0);
+    struct ggml_tensor * round = ggml_turbo_wht(ctx, fwd, 1, 0);
+    struct ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, round);
+    ggml_graph_compute_with_ctx(ctx, gf, 1);
+
+    float max_rel = 0.0f;
+    const float * output = (const float *) round->data;
+    for (int64_t i = 0; i < n; i++) {
+        const float rel = std::fabs(output[i] - input[i]) / std::fmax(1.0f, std::fabs(input[i]));
+        if (rel > max_rel) {
+            max_rel = rel;
+        }
+    }
+
+    const int64_t ne0_64 = 64;
+    const int64_t ne1_64 = 2;
+    const int64_t n_64 = ne0_64 * ne1_64;
+
+    struct ggml_tensor * a_64 = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne0_64, ne1_64);
+    std::vector<float> input_64(n_64);
+    for (int64_t i = 0; i < n_64; i++) {
+        input_64[i] = 0.35f * std::cos(0.17f * i) + 0.65f * std::sin(0.053f * i);
+        ((float *) a_64->data)[i] = input_64[i];
+    }
+
+    struct ggml_tensor * fwd_64 = ggml_turbo_wht(ctx, a_64, 0, 64);
+    struct ggml_tensor * round_64 = ggml_turbo_wht(ctx, fwd_64, 1, 64);
+    struct ggml_cgraph * gf_64 = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf_64, round_64);
+    ggml_graph_compute_with_ctx(ctx, gf_64, 1);
+
+    const float * output_64 = (const float *) round_64->data;
+    for (int64_t i = 0; i < n_64; i++) {
+        const float rel = std::fabs(output_64[i] - input_64[i]) / std::fmax(1.0f, std::fabs(input_64[i]));
+        if (rel > max_rel) {
+            max_rel = rel;
+        }
+    }
+
+    ggml_free(ctx);
+
+    if (!close_enough(max_rel, 0.0f, 1e-5f)) {
+        std::fprintf(stderr, "forward(inverse(x)) mismatch: max_rel=%.9f\n", max_rel);
+        return 1;
+    }
+
+    std::printf("test-turbo-wht: max_rel=%.9f\n", max_rel);
+    return 0;
+}
