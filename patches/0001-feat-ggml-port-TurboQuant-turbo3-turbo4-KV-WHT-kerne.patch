+
         const void * vx,
+
         dst_t * y,
+
         const int64_t k,
+
         cudaStream_t stream) {
+
     GGML_ASSERT(k % QK_NVFP4 == 0);
+
     const int nb = k / QK_NVFP4;
+
     dequantize_block_nvfp4<<<nb, 32, 0, stream>>>(vx, y, k);
+
 }
