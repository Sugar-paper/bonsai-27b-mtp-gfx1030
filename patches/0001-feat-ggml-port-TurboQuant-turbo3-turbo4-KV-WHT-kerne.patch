+
     else()
+
         message(FATAL_ERROR "GGML_OPENMP_FETCH does not support ${CMAKE_SYSTEM_PROCESSOR}")
+
     endif()
 
+
+
     set(GGML_OPENMP_CACHE_DIR "${CMAKE_BINARY_DIR}/_deps")
