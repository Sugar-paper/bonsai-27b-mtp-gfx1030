diff --git a/tools/kvmem/gen-turbo-tables.py b/tools/kvmem/gen-turbo-tables.py
new file mode 100644
index 0000000..39b5171
--- /dev/null
+++ b/tools/kvmem/gen-turbo-tables.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Regenerate the TurboQuant WHT sign tables used by the KVMem adapter.
+
+The KVMem adapter needs the same signed-FWHT constants as ggml's own TurboQuant
+codec. Hard-coding them twice would drift, so they are extracted from
+ggml/src/ggml-cuda/turbo-quant.cuh and emitted as two headers:
+
+  src/adapter/llama-kvmem-turbo-host.h    static const float  (host .cpp)
+  src/adapter/llama-kvmem-turbo-device.h  __constant__ float  (stagein .cu)
+
+Two files, not one, because a single declaration cannot be both __constant__
+(device) and static const (host): the stage-in translation unit and the adapter
+.cpp files each include exactly one of them.
+
+Only the 128-element WHT tables are emitted. The 64-element variants in
+turbo-quant.cuh are their first 64 entries (both the CUDA and the CPU codec use
+the same array with a smaller group size), so a second pair would be redundant.
+
+The codebooks and their midpoint tables are emitted too: the stage-in quantiser
+has to make exactly the same nearest-centroid decision as k_set_rows_turbo3 in
+ggml/src/ggml-cuda/set-rows.cu, and a second hand-copied copy of these constants
+is the classic way for the two to drift apart.
+
+Usage:
+    python tools/kvmem/gen-turbo-tables.py [--root <fusion tree>] [--check]
+
+--check regenerates into memory and diffs against the files on disk; it exits
+non-zero if they are stale. That is the guard for "did someone edit the .cuh".
+"""
+
+from __future__ import annotations
+
+import argparse
+import pathlib
+import re
+import sys
+
+ARRAYS = (
+    "TURBO_CENTROIDS_3BIT",
+    "TURBO_MID_3BIT",
+    "TURBO_CENTROIDS_4BIT",
+    "TURBO_MID_4BIT",
+    "TURBO_WHT_SIGNS1",
+    "TURBO_WHT_SIGNS2",
+)
+
+HOST_HEADER = "src/adapter/llama-kvmem-turbo-host.h"
+DEVICE_HEADER = "src/adapter/llama-kvmem-turbo-device.h"
+
+BANNER = """// GENERATED FILE -- do not edit.
+// Source : ggml/src/ggml-cuda/turbo-quant.cuh
+// Emitter: tools/kvmem/gen-turbo-tables.py
+//
+// TurboQuant constants, copied verbatim from ggml's own CUDA codec so the KVMem
+// stage-in cannot drift away from the kernels that write the cache natively.
+//
+//   CENTROIDS_* / MID_*  Lloyd-Max codebooks and their decision boundaries
+//   WHT_SIGNS1/2         signed-FWHT sign stages. The forward transform is
+//                            x -> s2 * FWHT(x * s1) / sqrt(group)
+//                        (turbo_rotate_forward in turbo-quant.cuh). The
+//                        butterfly is orthonormal, so the inverse swaps the two
+//                        sign stages.
+//
+// Only the 128-entry WHT tables live here: the 64-element group uses their first
+// 64 entries, exactly as the CUDA and CPU codecs do.
+"""
+
+
+def parse_arrays(cuh: pathlib.Path) -> dict[str, list[float]]:
+    text = cuh.read_text(encoding="utf-8")
+    out: dict[str, list[float]] = {}
+    for name in ARRAYS:
+        m = re.search(
+            r"__constant__\s+float\s+" + name + r"\s*\[\s*(?P<n>\d+)\s*\]\s*=\s*\{(?P<body>.*?)\}\s*;",
+            text,
+            re.S,
+        )
+        if not m:
+            raise SystemExit(f"{cuh}: could not find {name}")
+        want = int(m.group("n"))
+        body = re.sub(r"//[^\n]*", "", m.group("body"))
+        # The C literals carry an `f` suffix ("-1.0f"); float() rejects it.
+        vals = [float(tok.rstrip("fF")) for tok in re.findall(r"-?\d+\.?\d*f?", body)]
+        if len(vals) != want:
+            raise SystemExit(f"{cuh}: {name} has {len(vals)} entries, expected {want}")
+        out[name] = vals
+    return out
+
+
+def fmt_val(v: float) -> str:
+    """Round-trip a float as a C literal.
+
+    Not "{:.1f}": the codebooks are dense near zero (the smallest 3-bit centroid
+    is 0.021460) and one decimal place would collapse most of the table to 0.0.
+    Nine significant digits is well past float32 precision.
+    """
+    s = f"{v:.9g}"
+    if "." not in s and "e" not in s and "E" not in s:
+        s += ".0"
+    return s + "f"
+
+
+def fmt_table(name: str, vals: list[float], storage: str) -> str:
+    lines = []
+    for i in range(0, len(vals), 8):
+        chunk = ", ".join(fmt_val(v) for v in vals[i : i + 8])
+        lines.append("    " + chunk + ",")
+    joined = "\n".join(lines)
+    return f"{storage} float {name}[{len(vals)}] = {{\n{joined}\n}};\n"
+
+
+def render_host(vals: dict[str, list[float]]) -> str:
+    body = "\n".join(fmt_table(n, vals[n], "static const") for n in ARRAYS)
+    return BANNER + "\n#pragma once\n\n" + body
+
+
+def render_device(vals: dict[str, list[float]]) -> str:
+    body = "\n".join(fmt_table(n, vals[n], "__constant__") for n in ARRAYS)
+    return BANNER + "\n#pragma once\n\n" + body
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--root", default=".", help="fusion tree root")
+    ap.add_argument("--check", action="store_true", help="fail if the files are stale")
+    args = ap.parse_args()
+
+    root = pathlib.Path(args.root).resolve()
+    cuh = root / "ggml/src/ggml-cuda/turbo-quant.cuh"
+    if not cuh.is_file():
+        raise SystemExit(f"not found: {cuh}")
+
+    vals = parse_arrays(cuh)
+    targets = {
+        root / HOST_HEADER: render_host(vals),
+        root / DEVICE_HEADER: render_device(vals),
+    }
+
+    stale = []
+    for path, text in targets.items():
+        if args.check:
+            current = path.read_text(encoding="utf-8") if path.is_file() else None
+            if current != text:
+                stale.append(path)
+        else:
+            path.write_text(text, encoding="utf-8", newline="\n")
+            print(f"wrote {path}")
+
+    if args.check:
+        if stale:
+            for p in stale:
+                print(f"STALE {p}", file=sys.stderr)
+            return 1
+        print("turbo tables up to date")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
