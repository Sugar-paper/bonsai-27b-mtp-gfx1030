     if (ggml_is_quantized(type_k) || ggml_is_quantized(type_v)) {
+        // turbo3/turbo4 are accepted here. KVMem never interprets the cache on
+        // the device: the tiered store moves opaque packed rows
+        // (RawKvStore::write_layer_k_gpu / copy_k_gpu), so the block layout only
+        // has to round-trip through ggml_row_size + ggml_type_size, which the
+        // turbo codec provides. The head_dim divisibility rule lives in
+        // llama_kv_cache, which is the only place that can see hparams.
         const auto supported_quant = [](ggml_type type) {
-            return type == GGML_TYPE_Q8_0 || type == GGML_TYPE_Q5_0 || type == GGML_TYPE_Q4_0;
+            return type == GGML_TYPE_Q8_0 || type == GGML_TYPE_Q5_0 || type == GGML_TYPE_Q4_0 ||
+                   type == GGML_TYPE_TURBO3_0 || type == GGML_TYPE_TURBO4_0;
         };
         return supported_quant(type_k) && supported_quant(type_v);
     }
