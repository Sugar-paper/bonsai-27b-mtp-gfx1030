+// --- TurboQuant cache types -------------------------------------------------
+//
+// KVMem's tiered store treats GPU cache rows as opaque bytes: eviction and
+// restore are copy_k_gpu / copy_v_gpu / kvmem_stagein_h2d_bytes, so turbo3 and
+// turbo4 already round-trip without any codec of ours. The kernels below only
+// serve the slab stage-in path (kvmem_stagein_enqueue_k), which decodes a stored
+// row back to f32, RoPEs it, rotates it and re-encodes it into the live cache.
+//
+// That path must land byte-for-byte on what ggml's own k_set_rows_turbo3 /
+// k_set_rows_turbo4 would have written, otherwise a restored row would not match
+// the rows prefill wrote natively into the same cache. So the algorithm is a
+// straight port of ggml/src/ggml-cuda/set-rows.cu and the constants come from
+// the generated header rather than being retyped here.
+//
+// Difference from set-rows.cu: no __shfl_* and no __ballot_*. HIP's wavefront is
+// 64 on GCN and 32 on RDNA, and this tree builds for gfx1030, so every reduction
+// is a shared-memory tree and the sub-block packing is done by addressing shared
+// memory directly. Same result, wavefront-size independent.
+
+__device__ __forceinline__ uint8_t turbo_nearest_3bit(float val) {
+    if      (val < TURBO_MID_3BIT[0]) return 0;
+    else if (val < TURBO_MID_3BIT[1]) return 1;
+    else if (val < TURBO_MID_3BIT[2]) return 2;
+    else if (val < TURBO_MID_3BIT[3]) return 3;
+    else if (val < TURBO_MID_3BIT[4]) return 4;
+    else if (val < TURBO_MID_3BIT[5]) return 5;
+    else if (val < TURBO_MID_3BIT[6]) return 6;
+    else                              return 7;
+}
+
+__device__ __forceinline__ uint8_t turbo_nearest_4bit(float val) {
+    if      (val < TURBO_MID_4BIT[ 0]) return  0;
+    else if (val < TURBO_MID_4BIT[ 1]) return  1;
+    else if (val < TURBO_MID_4BIT[ 2]) return  2;
+    else if (val < TURBO_MID_4BIT[ 3]) return  3;
+    else if (val < TURBO_MID_4BIT[ 4]) return  4;
+    else if (val < TURBO_MID_4BIT[ 5]) return  5;
+    else if (val < TURBO_MID_4BIT[ 6]) return  6;
+    else if (val < TURBO_MID_4BIT[ 7]) return  7;
+    else if (val < TURBO_MID_4BIT[ 8]) return  8;
+    else if (val < TURBO_MID_4BIT[ 9]) return  9;
+    else if (val < TURBO_MID_4BIT[10]) return 10;
+    else if (val < TURBO_MID_4BIT[11]) return 11;
+    else if (val < TURBO_MID_4BIT[12]) return 12;
+    else if (val < TURBO_MID_4BIT[13]) return 13;
+    else if (val < TURBO_MID_4BIT[14]) return 14;
+    else                               return 15;
+}
+
+__global__ void dequant_turbo3(const block_turbo3_0 * x, float * y, int64_t n_blocks) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_blocks) {
+        return;
+    }
+    const float norm = __half2float(x[i].norm);
+#pragma unroll
+    for (int j = 0; j < QK_TURBO3; ++j) {
+        const uint8_t low2 = (x[i].qs[j / 4] >> ((j % 4) * 2)) & 0x3;
+        const uint8_t hi1  = (x[i].signs[j / 8] >> (j % 8)) & 0x1;
+        y[i * QK_TURBO3 + j] = TURBO_CENTROIDS_3BIT[low2 | (hi1 << 2)] * norm;
+    }
+}
+
+__global__ void dequant_turbo4(const block_turbo4_0 * x, float * y, int64_t n_blocks) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_blocks) {
+        return;
+    }
+    const float norm = __half2float(x[i].norm);
+#pragma unroll
+    for (int j = 0; j < QK_TURBO4; ++j) {
+        const uint8_t idx = (x[i].qs[j / 2] >> ((j % 2) * 4)) & 0xF;
+        y[i * QK_TURBO4 + j] = TURBO_CENTROIDS_4BIT[idx] * norm;
+    }
+}
+
+// One thread block per WHT group. GROUP has to match the size ggml records in
+// the cache op_params: (head_dim % 128 == 0) ? 128 : 64. Every group is
+// 32-element storage blocks, so GROUP / QK_TURBO3 sub-blocks share one L2 norm
+// and one reconstruction-corrected scale factor, exactly as in set-rows.cu.
+template <int GROUP>
+__global__ void quant_turbo3_grouped(const float * __restrict__ src,
+                                     block_turbo3_0 * __restrict__ dst,
+                                     int64_t n_groups) {
+    static_assert(GROUP == 128 || GROUP == 64, "turbo3 group must be 128 or 64");
+    constexpr int N_SUB = GROUP / QK_TURBO3;   // 32-element storage blocks
+    constexpr int N_QS  = QK_TURBO3 / 4;      // qs bytes per sub-block
+    constexpr int N_SG  = QK_TURBO3 / 8;      // sign bytes per sub-block
+    constexpr float INV_SQRT_GROUP = (GROUP == 128) ? 0.08838834764831845f : 0.125f;
+
+    const int j = threadIdx.x;
+    const int64_t g = blockIdx.x;
+    if (g >= n_groups) {
+        return;
+    }
+
+    __shared__ float   s_x[GROUP];
+    __shared__ float   s_red[GROUP];
+    __shared__ float   s_scale;
+    __shared__ uint8_t s_idx[GROUP];
+
+    const float v = src[g * GROUP + j];
+
+    // ---- group L2 norm -----------------------------------------------------
+    s_red[j] = v * v;
+    for (int h = GROUP / 2; h > 0; h >>= 1) {
+        __syncthreads();
+        if (j < h) {
+            s_red[j] += s_red[j + h];
+        }
+    }
+    __syncthreads();
+    if (j == 0) {
+        const float grp_norm = sqrtf(s_red[0]);
+        s_red[0] = grp_norm;
+        s_scale  = (grp_norm > 1e-10f) ? 1.0f / grp_norm : 0.0f;
+    }
+    __syncthreads();
+    const float grp_norm = s_red[0];
+    const float inv_norm = s_scale;
+
+    // ---- normalize, then signed FWHT: signs1 -> butterfly -> signs2 --------
+    s_x[j] = v * inv_norm * TURBO_WHT_SIGNS1[j];
+    __syncthreads();
