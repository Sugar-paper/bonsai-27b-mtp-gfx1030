+// tree's server-common.h only pulls in mtmd.h, so include it explicitly:
+// mtmd_helper_decode_image_chunk_with_decoder comes from the KVMem patch.
+#include "mtmd-helper.h"
 
 #include <algorithm>
 #include <chrono>
