--- /dev/null
+++ b/tools/kvmem/CMakeLists.txt
@@ -0,0 +1,57 @@
+# KVMem's own server and CLI.
+#
+# These are NOT optional extras: the stock llama-server has no idea KVMem
+# exists. The tiered store is switched on by llama_kvmem_set_params() before
+# llama_init_from_model, and the --kvmem* flags are parsed by these two tools
+# (hand-rolled parser, not common/arg.cpp). So this is the only binary pair
+# through which the fused adapter is actually reachable.
+#
+# Upstream (kvmem-llama.cpp) declares these targets in its superproject root,
+# where llama.cpp is a subdirectory. Here the fusion tree *is* the llama.cpp
+# tree, so they are declared beside the other tools instead.
+
+if (NOT LLAMA_KVMEM)
+    return()
+endif()
+
+set(_kvmem_tools ${CMAKE_CURRENT_SOURCE_DIR})
+
+# llama-kvmem-server: KVMem's drop-in replacement for tools/server.
+# server-common.cpp is compiled here as well -- upstream does the same, and in
+# this tree it carries the KVMem-aware request plumbing added by the patch.
+add_executable(llama-kvmem-server
+    ${_kvmem_tools}/llama-kvmem-server.cpp
+    ${_kvmem_tools}/kvmem-spec.cpp
+    ${_kvmem_tools}/kvmem-vision.cpp
+    ${CMAKE_SOURCE_DIR}/tools/server/server-common.cpp)
+
+target_include_directories(llama-kvmem-server PRIVATE
+    ${_kvmem_tools}
+    ${LLAMA_KVMEM_ROOT}/src/adapter
+    ${CMAKE_SOURCE_DIR}/include
+    ${CMAKE_SOURCE_DIR}/common
+    ${CMAKE_SOURCE_DIR}/tools/server
+    ${CMAKE_SOURCE_DIR}/tools/mtmd
+    ${CMAKE_SOURCE_DIR}/vendor
+    ${CMAKE_SOURCE_DIR}/vendor/cpp-httplib)
+
+target_link_libraries(llama-kvmem-server PRIVATE llama llama-common cpp-httplib mtmd)
+target_compile_features(llama-kvmem-server PRIVATE cxx_std_17)
+target_compile_definitions(llama-kvmem-server PRIVATE
+    KVMEM_ENABLE_NVME=$<BOOL:${KVMEM_ENABLE_NVME}>)
+
+# llama-kvmem-cli: single-shot decoder with the same --kvmem* surface.
+add_executable(llama-kvmem-cli
+    ${_kvmem_tools}/llama-kvmem-cli.cpp
+    ${_kvmem_tools}/kvmem-spec.cpp)
+
+target_include_directories(llama-kvmem-cli PRIVATE
+    ${_kvmem_tools}
+    ${LLAMA_KVMEM_ROOT}/src/adapter
+    ${CMAKE_SOURCE_DIR}/include
+    ${CMAKE_SOURCE_DIR}/common)
+
+target_link_libraries(llama-kvmem-cli PRIVATE llama llama-common)
+target_compile_features(llama-kvmem-cli PRIVATE cxx_std_17)
+target_compile_definitions(llama-kvmem-cli PRIVATE
+    KVMEM_ENABLE_NVME=$<BOOL:${KVMEM_ENABLE_NVME}>)
